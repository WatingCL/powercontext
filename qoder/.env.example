# 复制为 .env 后按需修改；不要提交真实密钥
# PowerContext Server 地址（默认本地 8000 端口）
POWERCONTEXT_URL=http://127.0.0.1:8000

# 一个研究方向一个 scope，换课题时改这里
LITCONTEXT_SCOPE_KEY=litcontext-nilm-event-detection
LITCONTEXT_SCOPE_TITLE=NILM 事件检测（毕业设计）

# 本地索引位置（默认 qoder/.data）
# LITCONTEXT_DATA_DIR=.data

# PowerContext 调用超时（秒）
LITCONTEXT_TIMEOUT=20
