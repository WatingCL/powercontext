# 复制为 .env 后按需修改；不要提交真实密钥
# 《记仇的酒馆掌柜》Dify + PowerContext 作品配置

# --- PowerContext Server ---------------------------------------------------
# 启动：powercontext server run （默认监听 127.0.0.1:8000）
POWERCONTEXT_URL=http://127.0.0.1:8000

# 演示作用域 ID，由 init/powercontext_init.py --new 生成后打印
PC_SCOPE_ID=scp_xxxxxxxxxxxxxxxx

# --- Dify 应用环境变量（在 Dify 控制台「环境变量」面板填写）------------------
# 自托管 Dify（与 PowerContext 同机）：PC_BASE_URL=http://127.0.0.1:8000
# Dify Cloud（跨网络）：PC_BASE_URL=内网穿透公网地址，例如 https://xxxxxxxx.lhr.life
PC_BASE_URL=http://127.0.0.1:8000

# --- DeepSeek 模型（在 Dify「模型供应商」里配置，切勿写入仓库）--------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-pro
