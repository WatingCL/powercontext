# SDD context module configuration (copy to .env and fill in real values)
# Never commit real credentials.

# --- storage backend ------------------------------------------------------
# seekdb  : embedded OceanBase seekdb via pyseekdb/pylibseekdb (Linux, default)
# mysql   : seekdb server or OceanBase over the MySQL protocol
# sqlite  : local development smoke tests only (NOT for evaluation)
SDD_STORE_BACKEND=seekdb
SDD_SEEKDB_PATH=.sdd/seekdb

# Only needed when SDD_STORE_BACKEND=mysql, e.g. seekdb docker:
#   docker run -d --name seekdb -p 2881:2881 -p 2886:2886 oceanbase/seekdb:latest
# SDD_STORE_MYSQL_URL=mysql://root@127.0.0.1:2881/sdd

# --- PowerContext ----------------------------------------------------------
# Start with: powercontext server run
POWERCONTEXT_URL=http://127.0.0.1:8000

# --- MiniMax ---------------------------------------------------------------
# Create a key at https://platform.minimaxi.com  (接口密钥)
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# Example models: MiniMax-M2, MiniMax-Text-01 (use one your account supports)
MINIMAX_MODEL=MiniMax-M2
